{
  "name": "rebatedor-cli",
  "version": "1.0.0",
  "description": "CLI para gerenciamento dos rebatedores",
  "type": "module",
  "bin": {
    "rebatedor": "./cli/rebatedor.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^5.2.1",
    "log-update": "8.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.3"
  },
  "scripts": {
